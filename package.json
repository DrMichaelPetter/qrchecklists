{
  "name": "checklists",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "jsqr": "^1.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.3.0",
    "react-router-dom": "^7.18.3",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11"
  },
  "scripts": {
    "start": "GENERATE_SOURCEMAP=false REACT_APP_BUILD_ID=$(git rev-parse --short HEAD)@$(date -u +%Y%m%d%H%M%S) react-scripts start",
    "build": "GENERATE_SOURCEMAP=false REACT_APP_BUILD_ID=$(git rev-parse --short HEAD)@$(date -u +%Y%m%d%H%M%S) react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "homepage": "./",
  "overrides": {
    "typescript": "4.9.5"
  }
}
